ci.ocamllabs.io:8100 {
	redir https://ocaml.ci.dev:8100{uri} permanent
}

ocaml.ci.dev:8100 {
	handle /webhooks/* {
		reverse_proxy ci:8080
	}
	handle {
		reverse_proxy ci:8080
	}
}

ci.ocamllabs.io:8200 {
	redir https://ocaml.ci.dev:8200{uri} permanent
}

ocaml.ci.dev:8200 {
	handle /webhooks/* {
		reverse_proxy gitlab:8080
	}
	handle {
		reverse_proxy gitlab:8080
	}
}

ci.ocamllabs.io {
	redir https://ocaml.ci.dev{uri} permanent
}

ocaml.ci.dev {
	reverse_proxy web:8090
}

status.ci.ocamllabs.io {
	redir https://status.ocaml.ci.dev{uri} permanent
}

status.ocaml.ci.dev {
	reverse_proxy grafana:3000
}

prometheus.ci.dev {
        basic_auth bcrypt {
		prometheus {{ prometheus_password }}
        }
        reverse_proxy prometheus:9090
}

opam-repo.ci.ocaml.org {
	route {
		# Same crawler/bot protection as the web UI host; the engine web
		# server on :8080 is reachable directly here, so crawlers hitting
		# this host would flood the engine without touching opam-repo-ci-web.
		@badbots header_regexp User-Agent (?i)(bot|crawl|spider|scrap|googleother|gptbot|chatgpt|oai-searchbot|ccbot|claudebot|anthropic|bytespider|petalbot|semrush|ahrefs|mj12|dotbot|dataforseo|meta-externalagent|imagesift|python-requests|go-http-client|libwww|okhttp|curl|wget)
		respond @badbots 403

		handle /robots.txt {
			respond "User-agent: *
Disallow: /job/
" 200
		}

		handle /metrics {
			basic_auth bcrypt {
				prometheus {{ prometheus_password }}
			}
			reverse_proxy opam-repo-ci:8080
		}

		# Backstop: cap the engine dashboard's /job/ log pages against crawlers
		# walking the whole build history (HEAD-crawl of /job/ observed 2026-06-17).
		rate_limit {
			zone engine_job {
				match {
					path /job/*
				}
				key    static
				events 10
				window 1s
			}
		}

		reverse_proxy opam-repo-ci:8080
	}
}

opam.ci.ocaml.org {
	route {
		# Block declared crawlers/scrapers and AI bots by User-Agent.
		# NOTE: the bulk load is a rotating residential-proxy farm that
		# spoofs real browser UAs; UA-blocking cannot stop that - it needs
		# a rate-limit plugin or upstream WAF. This catches the polite/declared bots.
		@badbots header_regexp User-Agent (?i)(bot|crawl|spider|scrap|googleother|gptbot|chatgpt|oai-searchbot|ccbot|claudebot|anthropic|bytespider|petalbot|semrush|ahrefs|mj12|dotbot|dataforseo|meta-externalagent|imagesift|python-requests|go-http-client|libwww|okhttp|curl|wget)
		respond @badbots 403

		# Scraper farm heuristic: Sec-Fetch-Site:none is a fresh/typed navigation,
		# which a real browser never sends together with a Referer. Real in-site
		# clicks use same-origin and GitHub links use cross-site, so they pass.
		@spoofnav {
			header Sec-Fetch-Site none
			header Referer *
		}
		respond @spoofnav 429

		# Ask polite crawlers not to walk the expensive per-build pages.
		handle /robots.txt {
			respond "User-agent: *
Disallow: /github/
" 200
		}

		# Backstop: global cap on the expensive per-build pages so the engine
		# cannot be overwhelmed even if the crawl adapts past @spoofnav.
		# key static => one shared bucket regardless of source-IP rotation.
		# NB: Caddy path '*' does not cross '/', so '*/variant/*' (not
		# '/github/*/commit/*/variant/*') is needed to match the 2-segment owner/repo.
		rate_limit {
			zone opam_variant {
				match {
					path */variant/*
				}
				key    static
				events 10
				window 1s
			}
		}

		reverse_proxy opam-repo-ci-web:8090
	}
}

ci.mirage.io {
	redir https://ci.mirageos.org{uri} permanent
}

deploy.mirage.io {
	redir https://deploy.mirageos.org{uri} permanent
}

ci.mirageos.org {
	reverse_proxy mirage-ci:8080 {
		transport http {
			versions 1.1
		}
	}
}

sandmark.ocamllabs.io, sandmark.tarides.com {
	reverse_proxy sandmark:8501
}

scheduler.ci.dev {
	basic_auth bcrypt {
		prometheus {{ prometheus_password }}
	}
	reverse_proxy prometheus:9090
}

status.ci3.ocamllabs.io {
	redir https://status.ocaml.ci.dev{uri} permanent
}

images.ci.ocaml.org {
	handle /metrics {
		basic_auth bcrypt {
			prometheus {{ prometheus_password }}
		}
		reverse_proxy base-images:8080
	}
	reverse_proxy base-images:8080 {
		transport http {
			versions 1.1
		}
	}
}

deploy.ci3.ocamllabs.io {
	redir https://deploy.ci.dev{uri} permanent
}

deploy.ci.dev {
	reverse_proxy tarides-deployer:8080 {
		transport http {
			versions 1.1
		}
	}
}

deploy.mirageos.org {
	reverse_proxy mirage-deployer:8080 {
		transport http {
			versions 1.1
		}
	}
}
